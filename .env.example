# Google Sheets Configuration
# Primary workbook: "3. Staff Tracker" + "4. Report Calendar".
GOOGLE_SHEET_ID=1blcm4q94bmszP7t-ffLKwOwxUqsQVhHzRJwUOWODFtM
# Second workbook ("MIS_Checklist_Full"). Only its two register tabs are in scope
# — "MIS_Closing_Report (M)" and "MIS_Closing_Report (Y)". Its third tab,
# "Monthly ", is a different Priority/% Done format and is never read or written.
# The full in-scope list lives in CONFIG.REPORT_SOURCES (src/config/index.ts).
MIS_CHECKLIST_SHEET_ID=1Vb9hjvpq12RglR3rCZlIzpK04mXv9rNrVJ1E0-gq4PQ
# Path to Google Cloud Service Account JSON Key file OR raw JSON string
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# First month of the financial year (1-12) — drives the "Yearly" cadence window.
# 4 = April (Indian FY). Set to 1 for a calendar year.
FINANCIAL_YEAR_START_MONTH=4

# Gmail OAuth2 Configuration (Personal Gmail Account: mbaplclaudereply@gmail.com)
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2callback
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# Database Configuration (Supabase or Neon PostgreSQL)
# Percent-encode special characters in the password (@ -> %40, # -> %23) or the
# driver misparses the host.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# This file is COMMITTED to git. Put placeholders here only — real keys belong in
# .env, which is gitignored.

# Anthropic Claude API Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini — used ONLY for the attachment summaries shown on the Summary tab
# and in the agent detail panel. Optional: leave unset and summaries are skipped
# silently; every other part of the pipeline behaves identically.
GEMINI_API_KEY=your-gemini-api-key

# CFO Agent Operations & Safety Control
REQUIRE_APPROVAL=true
APPROVAL_TIMEOUT_HOURS=4
OPERATOR_EMAIL=mbaplclaudereply@gmail.com
REPLY_FORWARD_EMAIL=mbaplclaudereply@gmail.com
OWN_SENDER_EMAILS=mbaplclaudereply@gmail.com
